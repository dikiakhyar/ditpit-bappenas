# Salin menjadi .env.local lalu isi nilainya. Di hosting (mis. Vercel) isi di
# Project Settings → Environment Variables, lalu deploy ulang.

# API key CARTO Basemaps (basemap "Peta" / Positron). Wajib agar tile tidak ber-watermark.
# Kelola/batasi domain di https://dashboard.basemaps.carto.com
NEXT_PUBLIC_CARTO_KEY=

# (opsional) database — lihat docs/DATABASE.md
# KAWASAN_SHEET_ID=
# DATABASE_SHEET_ID=
# DATABASE_XLSX_URL=
# DATABASE_REFRESH_TOKEN=
