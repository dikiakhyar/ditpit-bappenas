# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# paket zip hasil unduhan/perbaikan yang diekstrak di root proyek
/*.zip

# SHP sumber batas wilayah (±200 MB, melebihi batas GitHub) — yang di-commit hasil konversinya
# (public/data/wilayah.topo.json, darat.geojson). Lihat DATA-MAKRO.md.
/components/KabKotaPIT.*

# GPKG sumber Jalan Nasional (±64 MB) — yang di-commit hasil konversinya public/data/jalan-nasional.geojson
# (dibangun ulang dengan scripts/build-jalan-nasional.py bila GPKG diperbarui).
/components/JalanNasionalPIT.gpkg
